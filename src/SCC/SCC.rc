IDR_MAINFRAME           ICON                    "res\\SCC.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Acerca de SCC"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "SCC versión 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2006",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "Aceptar",IDOK,178,7,50,16,WS_GROUP
END

IDD_SCC_DIALOG DIALOGEX 0, 0, 244, 232
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "SCC"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_EFACTURA,78,7,78,14,ES_AUTOHSCROLL | ES_NUMBER
    COMBOBOX        IDC_CCLIENTE,78,23,90,156,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_ESERVICIO,78,39,78,14,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_EREMISION,78,56,78,14,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Aceptar",IDOK,173,22,50,16
    PUSHBUTTON      "Cancelar",IDC_BUTTON1,173,39,50,16
    PUSHBUTTON      "Todos",IDC_BUTTON2,173,56,50,16
    CONTROL         "",IDC_LDETALLE,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,7,76,229,149
    LTEXT           "Factura",IDC_STATIC,11,10,26,8
    LTEXT           "Cliente",IDC_STATIC,11,25,23,8
    LTEXT           "Número de servicio",IDC_STATIC,11,43,62,8
    LTEXT           "Remisión",IDC_STATIC,11,59,29,8
END


